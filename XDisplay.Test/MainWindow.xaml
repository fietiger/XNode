<Window
    x:Class="XDisplay.Test.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xd="clr-namespace:XDisplay.Core;assembly=XDisplay"
    Title="XDisplay 测试程序"
    Width="1200"
    Height="800"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  菜单栏  -->
        <Menu Grid.Row="0">
            <MenuItem Header="演示(_D)">
                <MenuItem
                    Name="MenuCreateComplexScene"
                    Click="MenuCreateComplexScene_Click"
                    Header="创建复杂场景(_C)" />
                <MenuItem
                    Name="MenuAutoFitDemo"
                    Click="MenuAutoFitDemo_Click"
                    Header="自动适应演示(_A)" />
                <MenuItem
                    Name="MenuContentBoundsInfo"
                    Click="MenuContentBoundsInfo_Click"
                    Header="内容边界信息(_B)" />
                <Separator />
                <MenuItem
                    Name="MenuEnableAutoFit"
                    Click="MenuEnableAutoFit_Click"
                    Header="启用实时自动适应(_R)"
                    IsCheckable="True" />
            </MenuItem>
            <MenuItem Header="坐标系(_C)">
                <MenuItem
                    Name="MenuMathCoordinates"
                    Click="MenuMathCoordinates_Click"
                    Header="数学坐标系 (Y向上)(_M)" />
                <MenuItem
                    Name="MenuScreenCoordinates"
                    Click="MenuScreenCoordinates_Click"
                    Header="屏幕坐标系 (Y向下)(_S)"
                    IsChecked="True" />
                <Separator />
                <MenuItem
                    Name="MenuCoordinateDemo"
                    Click="MenuCoordinateDemo_Click"
                    Header="坐标系演示(_D)" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem
                    Name="MenuAbout"
                    Click="MenuAbout_Click"
                    Header="关于(_A)" />
            </MenuItem>
        </Menu>

        <!--  工具栏  -->
        <ToolBarTray Grid.Row="1">
            <ToolBar>
                <Button
                    Name="BtnSelect"
                    Click="BtnSelect_Click"
                    Content="选择"
                    IsEnabled="False" />
                <Button
                    Name="BtnPan"
                    Click="BtnPan_Click"
                    Content="平移" />
                <Separator />
                <Button
                    Name="BtnDrawRect"
                    Click="BtnDrawRect_Click"
                    Content="矩形" />
                <Button
                    Name="BtnDrawRotatedRect"
                    Click="BtnDrawRotatedRect_Click"
                    Content="旋转矩形" />
                <Button
                    Name="BtnDrawCircle"
                    Click="BtnDrawCircle_Click"
                    Content="圆形" />
                <Button
                    Name="BtnDrawLine"
                    Click="BtnDrawLine_Click"
                    Content="线段" />
                <Button
                    Name="BtnDrawArrow"
                    Click="BtnDrawArrow_Click"
                    Content="箭头" />
                <Separator />
                <Button
                    Name="BtnLoadImage"
                    Click="BtnLoadImage_Click"
                    Content="加载图像" />
                <Button
                    Name="BtnCreateImageContainer"
                    Click="BtnCreateImageContainer_Click"
                    Content="创建图像容器" />
                <Separator />
                <Button
                    Name="BtnClearAll"
                    Click="BtnClearAll_Click"
                    Content="清空所有" />
                <Button
                    Name="BtnFitToView"
                    Click="BtnFitToView_Click"
                    Content="适应视图" />
                <Button
                    Name="BtnAutoFitAll"
                    Click="BtnAutoFitAll_Click"
                    Content="自动全局显示" />
                <Button
                    Name="BtnResetView"
                    Click="BtnResetView_Click"
                    Content="重置视图" />
                <Separator />
                <Button
                    Name="BtnMathCoordinates"
                    Click="BtnMathCoordinates_Click"
                    Content="数学坐标系(Y向上)" />
                <Button
                    Name="BtnScreenCoordinates"
                    Click="BtnScreenCoordinates_Click"
                    Content="屏幕坐标系(Y向下)"
                    IsEnabled="False" />
                <Separator />
                <Button
                    Name="BtnGenerateCoordinateSystems"
                    Click="BtnGenerateCoordinateSystems_Click"
                    Content="生成多层坐标系" />
                <Separator />
                <Button
                    Name="BtnPerformanceTest"
                    Background="LightYellow"
                    Click="BtnPerformanceTest_Click"
                    Content="性能测试(2000矩形)" />
                <CheckBox
                    Name="ChkShowGrid"
                    Checked="ChkShowGrid_Checked"
                    Content="显示网格"
                    IsChecked="True"
                    Unchecked="ChkShowGrid_Unchecked" />
                <CheckBox
                    Name="ChkShowCheckerboard"
                    Checked="ChkShowCheckerboard_Checked"
                    Content="棋盘格背景"
                    IsChecked="True"
                    Unchecked="ChkShowCheckerboard_Unchecked" />
            </ToolBar>
        </ToolBarTray>

        <!--  主显示区域  -->
        <!--  坐标系树形控件  -->
        <TreeView 
            x:Name="CoordinateSystemTree" 
            Grid.Row="2" 
            Grid.Column="0" 
            Margin="5" 
            SelectedItemChanged="CoordinateSystemTree_SelectedItemChanged" />
        
        <!--  图形显示控件  -->
        <Border
            Grid.Row="2"
            Grid.Column="1"
            Margin="0"
            Padding="0"
            BorderBrush="Gray"
            BorderThickness="1">
            <xd:XDisplayControl
                x:Name="DisplayControl"
                GeometryAdded="DisplayControl_GeometryAdded"
                GeometryRemoved="DisplayControl_GeometryRemoved"
                SelectionChanged="DisplayControl_SelectionChanged"
                ViewportTransformChanged="DisplayControl_ViewportTransformChanged" />
        </Border>

        <!--  状态栏  -->
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Name="TxtMode" Text="模式: 选择" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="TxtSelection" Text="选中: 无" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="TxtScale" Text="缩放: 100%" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="TxtGeometryCount" Text="图形数量: 0" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="TxtMouseCoordinates" Text="坐标: -" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前坐标系:" VerticalAlignment="Center" />
                    <ComboBox Name="CmbCoordinateSystems" Width="150" Margin="5,0" SelectionChanged="CmbCoordinateSystems_SelectionChanged" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Name="TxtCoordinateSystemInfo" Text="坐标系信息: 无" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>